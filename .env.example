# Browser-safe configuration only. Never put a service-role or Medusa admin
# secret in a VITE_* variable because Vite embeds it in the client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_MEDUSA_BASE_URL=http://localhost:9000
VITE_MEDUSA_CATALOGUE_ENABLED=false
# Optional public booking page URL used by the marketing "Book a demo" CTA.
# When omitted, the CTA opens a pre-filled email draft without a recipient.
VITE_DEMO_BOOKING_URL=

# Leave Supabase/Medusa values empty, or force this flag, to preserve the
# current mock/demo catalogue experience.
VITE_DEMO_MODE=true
