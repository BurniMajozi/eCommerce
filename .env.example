# Browser-safe configuration only. Never put a service-role or Medusa admin
# secret in a VITE_* variable because Vite embeds it in the client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_MEDUSA_BASE_URL=http://localhost:9000

# Leave Supabase values empty to preserve the current mock/demo experience.
VITE_DEMO_MODE=true
