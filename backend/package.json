{
  "name": "sightlive-medusa-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "medusa start",
    "db:migrate": "medusa db:migrate --yes",
    "db:generate": "medusa db:generate tenantLink",
    "bootstrap:commerce": "medusa exec ./src/scripts/bootstrap-commerce.ts",
    "bootstrap:links": "medusa exec ./src/scripts/bootstrap-links.ts",
    "bootstrap:products": "medusa exec ./src/scripts/bootstrap-products.ts",
    "config:check": "node scripts/check-config.mjs",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "^2.18.0",
    "@medusajs/framework": "^2.18.0",
    "@medusajs/medusa": "^2.18.0",
    "@medusajs/utils": "^2.18.0",
    "@mikro-orm/core": "6.6.16",
    "@mikro-orm/knex": "6.6.16",
    "@supabase/supabase-js": "^2.112.3",
    "awilix": "^8.0.1",
    "jose": "^6.1.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@mikro-orm/core": "6.6.16",
    "@mikro-orm/knex": "6.6.16",
    "@mikro-orm/migrations": "6.6.16",
    "@mikro-orm/postgresql": "6.6.16",
    "@mikro-orm/cli": "6.6.16"
  }
}
