{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".medusa/server"
  },
  "include": ["medusa-config.ts", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", ".medusa"]
}
