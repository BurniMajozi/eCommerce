NODE_ENV=development
PORT=9000

# Medusa owns commerce data. When sharing the Supabase PostgreSQL instance,
# use a dedicated database role and the non-exposed `medusa` schema.
DATABASE_URL=postgresql://medusa_app.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_SCHEMA=medusa

# Local: redis://localhost:6379
# Managed: rediss://USERNAME:PASSWORD@HOST:PORT/0
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=sightlive:
MEDUSA_WORKER_MODE=shared

STORE_CORS=http://localhost:5173
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:5173,http://localhost:7001
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters

# Server-only Supabase values. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Optional override for local Supabase.
SUPABASE_JWT_AUDIENCE=authenticated

# AgentMail transactional email (https://docs.agentmail.to). When both the key
# and inbox are set, the platform emails auth invites, approval decisions, sales
# confirmations, promo notices, purchase orders and invoices. Leave unset to
# disable email (the app runs fine; sends become no-ops).
AGENTMAIL_API_KEY=am_replace_me
AGENTMAIL_INBOX_ID=your-inbox-id-or-address
# Optional:
AGENTMAIL_FROM=SightLive <notifications@yourdomain.com>
AGENTMAIL_REPLY_TO=procurement@yourdomain.com
APP_PUBLIC_URL=https://your-app-url

# Supabase "Send Email" auth hook — lets email OTP / auth emails send via
# AgentMail. Create the hook in Supabase (Auth → Hooks → Send Email), paste its
# generated secret here, and point the hook URL at /hooks/send-email.
SUPABASE_SEND_EMAIL_HOOK_SECRET=v1,whsec_replace_me
